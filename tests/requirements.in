# The packages the tests use. tests/requirements.txt pins the exact version of
# each one, and of everything they depend on. After you edit this file, update
# it with:
#   uv pip compile --universal --python-version 3.10 tests/requirements.in -o tests/requirements.txt

# The same version the build pins in scripts/build_v2.py.
pyarrow==25.0.1
# The USAGE.md query turns off DuckDB 2.0's read-ahead, which would otherwise
# download about 11 MB of the Parquet file over HTTP and fail
# test_queries.ParquetOverHTTPTest. See #20. DuckDB 2.0 needs Python 3.11, so
# Python 3.10 stays on 1.5.6, where the test leaves the setting out, as
# USAGE.md says.
duckdb==2.0.1 ; python_version >= '3.11'
duckdb==1.5.6 ; python_version < '3.11'
pandas
